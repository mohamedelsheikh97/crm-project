# ---------------------------------------------------------------------------
# CRM-Support — environment configuration
#
# Copy this file to `.env` at the repository root and fill in the blanks.
# There is exactly ONE .env, and it lives here at the root: the backend loads
# it via ../../../.env and the frontend picks it up via `envDir: '..'` in
# vite.config.ts. Do NOT create backend/.env or frontend/.env.
#
# `.env` is git-ignored and must never be committed. This file is committed.
#
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET must be two DIFFERENT random
# strings of at least 32 characters. The backend refuses to start if they are
# equal or too short, because equal secrets defeat the access/refresh token
# separation entirely. Generate each one with:
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# CORS_ORIGIN must be an explicit origin. The backend refuses to start when it
# is `*`, because credentialed CORS forbids wildcard origins.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm_support
DB_USER=crm
DB_PASSWORD=crm_local_password

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Account security policy (Phase 1)
#
# All four are optional; the defaults shown are used when a variable is absent.
# They are read once at startup, so changing one requires a restart. A settings
# table would allow runtime edits, but Phase 1's configuration screens are an
# empty shell, so a table with no screen to edit it would be strictly worse.
#
# PASSWORD_MIN_LENGTH is floored at 8 — the policy cannot be configured below
# the minimum the service layer already enforced in Phase 0.
# ---------------------------------------------------------------------------

PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_SIZE=5
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Customer attachments and phone handling (Phase 2)
#
# All four are optional; the defaults shown are used when a variable is absent.
#
# ATTACHMENT_STORAGE_PATH must NEVER sit under a directory that is served
# statically. Every download streams through an authenticated,
# permission-checked endpoint — serving the directory directly would make an
# attachment reachable by anyone who obtains its address, which is the same
# defect as not checking permission at all.
#
# ATTACHMENT_ALLOWED_TYPES is matched against the type SNIFFED from the file's
# content, never against its extension or the client-supplied Content-Type.
# Both of those are claims, not facts.
#
# DEFAULT_PHONE_REGION is used to parse a number entered without a country
# code, so that +20 100 123 4567 and 01001234567 are recognised as the same
# number. Duplicate detection depends on this.
# ---------------------------------------------------------------------------

ATTACHMENT_STORAGE_PATH=./storage/attachments
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_ALLOWED_TYPES=application/pdf,image/png,image/jpeg,image/gif,image/webp,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
DEFAULT_PHONE_REGION=EG

# ---------------------------------------------------------------------------
# Agent dashboard (Phase 4)
#
# How long before a ticket's due date its assignee is warned. ONE system-wide
# value on purpose: per-priority and per-customer thresholds are Phase 6's SLA
# policy, not this one.
# ---------------------------------------------------------------------------

DUE_WARNING_LEAD_MINUTES=60

# --- SLA & automation (Phase 6) -------------------------------------------
# Operational tuning only. SLA policies, the business calendar, the assignment
# strategy, alert subscriptions and automation rules are database rows an
# administrator edits at runtime — not environment configuration.
SLA_WARNING_LEAD_MINUTES=60
AUTOMATION_MAX_DEPTH=3
ALERT_MAX_PER_RECIPIENT_PER_HOUR=20

# ---------------------------------------------------------------------------
# Communication channels (Phase 5)
#
# Every channel defaults to `simulator`, which exercises the full inbound and
# outbound path without contacting anything. That is what makes the whole phase
# demonstrable and testable with no commercial account.
#
# A simulator MUST NOT run in production. The process refuses to start when
# NODE_ENV=production and an ENABLED channel resolves to one, because that
# failure is otherwise invisible: tickets keep arriving and replies keep
# reporting as sent, while no customer ever hears anything.
#
# Enablement is NOT here. It lives in the `channel_settings` table, where an
# administrator can change it at runtime. What lives here is the PROVIDER,
# because it decides which code runs, and the credentials that provider needs.
#
# Each credential group below is required only when its channel's provider is
# not `simulator`. Startup validation enforces that pairing and names the
# missing variable, so a channel that cannot work says so immediately.
# ---------------------------------------------------------------------------

CHANNEL_EMAIL_PROVIDER=simulator
CHANNEL_WHATSAPP_PROVIDER=simulator
CHANNEL_SMS_PROVIDER=simulator

MAIL_POLL_SECONDS=60
INTAKE_RATE_PER_MINUTE=60
PUBLIC_RATE_PER_MINUTE=20

# The origin allowed to embed the chat widget. Deliberately separate from
# CORS_ORIGIN: the widget lives on a public marketing site, the application
# does not.
# CHAT_WIDGET_ORIGIN=https://www.example.com

# Signs the `support+<token>@` reply address used as the email threading
# fallback. Must be at least 32 characters. Required only with imap-smtp.
# CHANNEL_ADDRESS_TOKEN_SECRET=

# Required only when CHANNEL_EMAIL_PROVIDER=imap-smtp
# MAIL_IMAP_HOST=
# MAIL_IMAP_PORT=993
# MAIL_IMAP_USER=
# MAIL_IMAP_PASSWORD=
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# MAIL_FROM_ADDRESS=support@example.com

# Required only when CHANNEL_WHATSAPP_PROVIDER=cloud-api
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Required only when CHANNEL_SMS_PROVIDER=gateway
# SMS_API_BASE_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=
# SMS_WEBHOOK_SECRET=

VITE_API_BASE_URL=http://localhost:3000/api
