# ---------------------------------------------------------------------------
# CRM-Support — environment configuration
#
# Copy this file to `.env` at the repository root and fill in the blanks.
# There is exactly ONE .env, and it lives here at the root: the backend loads
# it via ../../../.env and the frontend picks it up via `envDir: '..'` in
# vite.config.ts. Do NOT create backend/.env or frontend/.env.
#
# `.env` is git-ignored and must never be committed. This file is committed.
#
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET must be two DIFFERENT random
# strings of at least 32 characters. The backend refuses to start if they are
# equal or too short, because equal secrets defeat the access/refresh token
# separation entirely. Generate each one with:
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# CORS_ORIGIN must be an explicit origin. The backend refuses to start when it
# is `*`, because credentialed CORS forbids wildcard origins.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm_support
DB_USER=crm
DB_PASSWORD=crm_local_password

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Account security policy (Phase 1)
#
# All four are optional; the defaults shown are used when a variable is absent.
# They are read once at startup, so changing one requires a restart. A settings
# table would allow runtime edits, but Phase 1's configuration screens are an
# empty shell, so a table with no screen to edit it would be strictly worse.
#
# PASSWORD_MIN_LENGTH is floored at 8 — the policy cannot be configured below
# the minimum the service layer already enforced in Phase 0.
# ---------------------------------------------------------------------------

PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_SIZE=5
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

VITE_API_BASE_URL=http://localhost:3000/api
